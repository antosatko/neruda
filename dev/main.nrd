scheduler main {
    resources {
        UnitCount { count: 0 }
    }

    systems {
        count_units
        cap_velocity
        apply_velocity
        on_stop_all
    }

    init => print("hello");
}

type StopAll
type UnitCount = struct { count: f32 }

component Position = f32x2
component Velocity = f32x2

// Select
system apply_velocity(e: mut Position as P & Velocity as V) => e.P += e.V
// Events
system on_stop_all(e: mut Velocity, on e: StopAll) => e.Velocity = 0
// Restrictions
system cap_velocity(e: mut Velocity as V, where e.V.dist() > 50) => e.V = e.V.normalize() * 50
// Aggregation (manual)
system count_units(_: Position, c: mut UnitCount)
    before { var tmp = UnitCount { count: 0 } }
    => tmp.count += 1
    after => c = tmp
