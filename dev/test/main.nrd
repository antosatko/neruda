type Vec<T> = struct {
    data: &[T]
    len: u32
    cap: u32
}


pub function foo(a: i32): i32 {
    if a > 50 {
        return 100
    } else {
        a = a + 10
        return danda(a) + 6
    }
}

pub function fib(n: i32): i32 {
    if n <= 1 {
        return n
    }
	var _0 = 0
	var _1 = 1
	var current = _0 + _1
	while n > 2 {
		_0 = _1
		_1 = current
        current = _0 + _1
		n = n - 1
	}
	return current
}

pub function id(v: i32): i32 {
	return v
}

pub function fact(n: i32): i32 {
    var _n = n - 1
    if n <= 1 {
        return n
    }
    return n * fact(n - 1)
}

pub function fib_rec(n: i32) : i32 {
    if n <= 1 {
        return n
    }
    var _1 = n - 1
    var _2 = n - 2
    return fib_rec(_1) + fib_rec(_2)
}

pub function loops(a: i32) {
    loop {
        if a <= 0 {
            return
        }
        a = a - 1
    }
}

function danda(a: i32): i32 {
    return a + 6
}
