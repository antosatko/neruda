import math as m
import graphics as g

using g::Vector2 as Vec2

resource UnitCount = 0
resource AvgUnitDirection = struct Vec2 { }

type StopAll

component Position = f32x2
component Velocity = f32x2
component Orbiting = entity

type A
type B
type C

invoke function main() {
    var _ = nevimco(69).&.*

    invoke {
        apply_velocity()
        on_stop_all()
        cap_velocity()
        count_units()
        orbit()
    }

    return
}


// Select
system apply_velocity(e: mut Position as P + Velocity as V) => e.P += e.V
// Events
system on_stop_all(e: mut Velocity, on _: StopAll) => e.Velocity = 0
// Restrictions
system cap_velocity(e: mut Velocity as V, where e.V.dist() > 50) => e.V = e.V.normalize() * 50
// Aggregation (manual)
system count_units(_: Position, count: mut UnitCount)
    before { var tmp = 0 }
    => tmp += 1
    after => count = tmp
// foreign entities
system orbit(
    satellite: mut Velocity as V + Position as P + Orbiting as C,
    foreign primary: Position as P
)
=> satellite.V += 1000 / (primary.get(satellite.C).P - satellite.P).pow(2)

function foo<T>(v: T): T => v
function bar(v: i32): i32 => v

function nevimco(in: i32): i32 {
    var _: function(a: A): A = foo<A>
    var _ = foo<B>
    var a = 5
    var _ = a.&.&.&.&.*
    var ref = a.&
    var five = foo<i32>(bar(bar(ref.*)))

    return 6 + a + in / five / five
}
