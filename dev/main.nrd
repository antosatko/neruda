scheduler main {
    resources {
        UnitCount(0)
    }

    systems {
        count_units
        cap_velocity
        apply_velocity
        // equivalent to `apply_velocity`
        // add<Position, Velocity>
        on_stop_all
    }

    init => print("hello")
}

type StopAll
type UnitCount = f32

component Position = f32x2
component Velocity = f32x2

// Select
system apply_velocity(e: mut Position as P & Velocity as V) => e.P += e.V
// Events
system on_stop_all(e: mut Velocity, on _: StopAll) => e.Velocity = 0
// Restrictions
system cap_velocity(e: mut Velocity as V, where e.V.dist() > 50) => e.V = e.V.normalize() * 50
// Aggregation (manual)
system count_units(_: Position, count: mut UnitCount)
    before { var tmp = 0 }
    => tmp += 1
    after => count = tmp

// generic components
system add<T, U>(e: mut T & U) => e.T += e.U
