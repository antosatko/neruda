import math as m

scheduler main {
    resources {
        UnitCount(0)
    }

    systems {
        count_units
        cap_velocity
        apply_velocity
        // equivalent to `apply_velocity`
        // add<Position, Velocity>
        on_stop_all
    }

    init => print("hello")
}

type StopAll
type UnitCount = u32

component Position = f32x2
component Velocity = f32x2
component Orbiting = entity


// Select
system apply_velocity(e: mut Position as P + Velocity as V) => e.P += e.V
// Events
system on_stop_all(e: mut Velocity, on _: StopAll) => e.Velocity = 0
// Restrictions
system cap_velocity(e: mut Velocity as V, where e.V.dist() > 50) => e.V = e.V.normalize() * 50
// Aggregation (manual)
system count_units(_: Position, count: mut UnitCount)
    before { var tmp = 0 }
    => tmp += 1
    after => count = tmp
// foreign entities
system orbit(
    satellite: mut Velocity as V + Position as P + Orbiting as C,
    foreign primary: Position as P
)
=> satellite.V += 1000 / (primary.get(satellite.C).P - satellite.P).pow(2)
// generic components
system add<T: AddEq, U>(e: mut T + U) => e.T += e.U


function im2tuple<T>(v: &m::Im<T>): (T, T) => (v[0], v[1])
type IPV4_ADDR = [bool; BYTE * 4]
const BYTE: u32 = 8

type _128_BYTES = [u8; Bits::Eight]
type Bits = enum (2 * self): u32 {
    Zero
    One = 1
    Two
    Three
    Four
    Five
    Six
    Seven
    Eight
}


const WIDTH: u32 = 1920
const HEIGHT: u32 = 1080
type DrawBuffer = [u32; WIDTH * HEIGHT]
type BufferType = enum {
    Front
    Back
    Count
}
type DoubleBuffer<T> = struct {
    data: [T; BufferType::Count]
    current: BufferType
}

type DrawSurface = DoubleBuffer<DrawBuffer>


function nevimco(): i32 {
    var a: i32 = 7
    var b: m::Im<DrawSurface>
    return a * 8
}
