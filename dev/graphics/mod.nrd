import mod::dev::algo

using algo::Vec

type DrawBuffer = Vec<u32>

type BufferType = enum (self + 1): u32 {
    Front
    Back
    Count
}

type DoubleBuffer<T> = struct {
    data: [T; BufferType::Count]
    current: BufferType = BufferType::Front
}

type DrawSurface = DoubleBuffer<DrawBuffer>

type Vector2 = struct {
    x: f32
    y: f32
}

type Vector3 = struct {
    x: f32
    y: f32
    z: f32
}
