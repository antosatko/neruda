type Vec<T> = struct {
    data: &[T]
    len: u32
    cap: u32
}

pub function fib(n: i32): i32 {
    if n <= 1 {
        return n
    }
	var _0 = 0
	var _1 = 1
	var current = _0 + _1
	while n > 2 {
		_0 = _1
		_1 = current
        current = _0 + _1
		n = n - 1
	}
	return -current
}

pub function fact(n: i32): i32 {
    if n <= 1 {
        return n
    }
    return n * fact(n - 1)
}

pub function fib_rec(n: i32): i32 {
    if n <= 1 {
        return n
    }
    return fib_rec(n - 1) + fib_rec(n - 2)
}
