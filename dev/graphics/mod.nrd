import mod::dev::algo
import main

using algo::*

pub type DrawBuffer = Vec<u32>

pub type BufferType = enum: u32{
    Front
    Back
    Count
}

pub type DoubleBuffer<T> = struct {
    data: [T; BufferType::Count]
    current: BufferType = BufferType::Front
}

pub type DrawSurface = DoubleBuffer<DrawBuffer>

pub type Vector2 = struct {
    x: f32
    y: f32
}

pub type Vector3 = struct {
    x: f32
    y: f32
    z: f32
}
