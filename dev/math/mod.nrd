pub type Im<S> = (S, S)

pub type ImFloat = Im<f32>
pub type ImInt = Im<i32>

pub const PI: f32 = 3.14159265359

impl <S: Add> Add for Im<S> {
    function add(self: &Self, other: &Self): Self => (
        self[0] + other[0],
        self[1] + other[1],
    )
}

pub trait Add {
    function add(self: &Self, other: &Self): Self => _
}

pub trait Sub {
    function sub(self: &Self, other: &Self): Self => _
}

pub type AddAndSub<T: Add + Sub> = T

pub function name(params: i32) => _
